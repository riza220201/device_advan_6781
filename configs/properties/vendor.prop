#
# /vendor/build.prop additions, wired up as TARGET_VENDOR_PROP in
# BoardConfig.mk.
#
# Generated mechanically from Advan stock ADVAN_6781_S34NF2_V4.0_20250304
# /vendor/build.prop (785 lines, 2026-09-19), then curated by rule -- NOT by
# taste. Stock's file concatenates a generic MGVI section and the Prize/ODM
# product section, so 89 keys are declared twice:
#
#   * ro.*  is write-once: the FIRST (generic) value wins. Kept as stock
#     resolves it. (85 of the 89 agree in both sections anyway.)
#   * everything else is last-writer-wins: the product value is kept. Four
#     keys actually differ. The two ro.* ones keep the FIRST (generic)
#     value, as stock's write-once resolution does: ro.vendor.mtk_f2fs_enable
#     =0 (product says 1), ro.vendor.mtk_pq_color_mode=3 (product says 1).
#     The two non-ro ones keep the product value: vendor.camera.mdp.cz.enable
#     =1 and vendor.camera.mdp.dre.enable=1 (generic says 0).
#
# NOT carried over from stock:
#   * identity (ro.product.*, ro.*.build.*, fingerprints, dates, cpu abilists)
#     -- a ROM decision, set by the build recipe, not by the device tree.
#   * anything the build system owns: ro.zygote, ro.vndk.version,
#     ro.board.platform (build sets mt6789 from TARGET_BOARD_PLATFORM; stock
#     resolves its own duplicate to the generic `common`), first_api_level,
#     ro.virtual_ab.*, ro.boot.dynamic_partitions, ro.bionic.*, dalvik.*
#     (the heap makefile owns them -- lineage_6781.mk inherits
#     phone-xhdpi-6144-dalvik-heap.mk, so excluding them here is what makes
#     that inheritance take effect), persist.sys.dalvik.*, ro.build.ab_update.
#   * persist.sys.usb.config -- the build variant decides, never the tree.
#   * ro.hwui.use_vulkan (stock sets it empty) and ro.sf.lcd_density
#     (BoardConfig's TARGET_SCREEN_DENSITY owns it -- one writer per key).
#
# A value containing a SPACE must live here (or in system.prop), never in
# PRODUCT_*_PROPERTIES (whitespace-separated there).
#

#
# remosaic daemon (camera full-res path): a vndbinder daemon publishing
# android.IRemosaicDaemon, consumed by mtk_hal_camera. Rules measured from
# Advan stock's vendor_sepolicy.cil 2026-09-19.
#
# The TYPES and LABELS come from device/mediatek/sepolicy_vndr, not from
# here: remosaic_daemon (basic/non_plat), remosaic_daemon_exec +
# init_daemon_domain + vndbinder_use (bsp/non_plat), remosaic_daemon_service
# as a vndservice_manager_type (bsp/non_plat/vndservice.te), the exec label
# (bsp/non_plat/file_contexts) and android.IRemosaicDaemon
# (bsp/non_plat/vndservice_contexts). An earlier revision of this file
# declared all three types itself, claiming sepolicy_vndr did not -- it does,
# and checkpolicy stopped build ab on it ("Duplicate declaration of type
# remosaic_daemon"). That revision also typed the service as
# service_manager_type, the wrong manager for a vndservice.
#
# What stays here is only what sepolicy_vndr's remosaic files lack and stock
# grants (duplicate allow rules are legal, so overlap is harmless).
#
# Inert on this build either way: stock ships no remosaic_daemon binary and
# no init rc for it (JOURNAL 2026-09-19); the tester gate is `vndservice
# list`, not the policy.

allow remosaic_daemon remosaic_daemon_exec:file { read getattr map execute open entrypoint };
allow remosaic_daemon remosaic_daemon_service:service_manager add;
allow remosaic_daemon mtk_hal_camera:binder transfer;
allow remosaic_daemon mtk_hal_camera:fd use;
allow mtk_hal_camera remosaic_daemon_service:service_manager find;

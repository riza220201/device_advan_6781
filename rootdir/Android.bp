// Everything else under rootdir/ is plain data and ships through
// PRODUCT_COPY_FILES in device.mk. This one file needs the execute bit, and
// PRODUCT_COPY_FILES installs 0644.
//
// init.mtkgki.rc runs it as:
//   service insmod_sh /vendor/bin/init.insmod.sh \
//       /vendor/etc/init.insmod.${ro.hardware}.cfg
// and the cfg's directives are `modprobe|*` then
// `setprop|vendor.all.modules.ready` (rootdir/etc/init.insmod.mt6789.cfg).
// The label (init_insmod_sh_exec) comes from device/mediatek/sepolicy_vndr.
//
// Build q (2026-09-20) failed on this module's absence: device.mk requested
// it and the generator excluded stock's copy, but nothing defined it.
sh_binary {
    name: "init.insmod.sh",
    src: "bin/init.insmod.sh",
    vendor: true,
}
